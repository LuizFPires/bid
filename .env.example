# === bid · variáveis de ambiente (exemplo) ===
# Copie para .env e preencha. NUNCA versione .env com valores reais.

# ---- Cliente (expostas no navegador — prefixo VITE_) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Servidor (apps/api, Supabase Edge, CI) — NUNCA no cliente ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Modelos Claude (configuráveis)
ANTHROPIC_MODEL_EXTRACT=claude-haiku-5-5
ANTHROPIC_MODEL_EQUALIZE=claude-sonnet-5-5
